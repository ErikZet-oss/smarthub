{
  "username_selector": "input[name=\"username\"]",
  "password_selector": "input[name=\"password\"]",
  "login_button_selector": "button[data-testid=\"login-button\"]",
  "login_expect_spring_security_post": false,
  "search_via_url_template": "https://eshop.mekrs.cz/produkty?nazev={code}",
  "navigation_goto_wait_until": "domcontentloaded",
  "navigation_timeout_ms": 20000,
  "post_search_wait_ms": 250,
  "first_product_link_selector": "[data-testid=\"product-card\"] a[href], [data-testid=\"product-card\"]",
  "price_currency_select_selector": "select.inline-block.cursor-pointer.bg-primaryRed",
  "price_currency_select_value": "EUR",
  "price_selector": "span.text-black.font-bold.text-sm.leading-none, span.text-primaryRed.font-bold.text-lg",
  "price_stock_timeout_ms": 5500,
  "stock_selector": "div.text-primaryGreen:has-text(\"Skladem\")",
  "packaging_modal_open_selector": "button:has-text(\"Vložit do košíku\"):not([data-testid=\"add-to-cart\"])",
  "add_to_cart_selector": "button:has-text(\"Vložit do košíku\")",
  "quantity_input_selector": "section:has-text(\"Vyberte variantu\") input[inputmode=\"numeric\"]",
  "add_to_cart_confirm_selector": "button[data-testid=\"add-to-cart\"]",
  "packaging_modal_visible_selector": "text=Vyberte variantu",
  "packaging_modal_header_stock_selector": "section:has-text(\"Vyberte variantu\") header div.text-primaryGreen",
  "packaging_abort_cart_mutation_posts": true,
  "post_modal_open_wait_ms": 150,
  "post_add_wait_ms": 700,
  "post_login_wait_ms": 450,
  "headless": true,
  "block_heavy_assets": true
}
