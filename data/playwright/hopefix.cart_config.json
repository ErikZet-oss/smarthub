{
  "login_url": "https://www.hopefix.cz/prihlaseni",
  "after_login_url": "https://www.hopefix.cz/",
  "optional_cookie_dismiss_selector": "#cookiescript_reject",
  "username_selector": "form.login_form input[name=\"email\"]",
  "password_selector": "form.login_form input[name=\"password\"]",
  "login_button_selector": "form.login_form button[type=\"submit\"]",
  "login_expect_spring_security_post": false,
  "post_login_wait_ms": 320,
  "search_input_selector": "#search_input",
  "search_pick_first_suggestion": true,
  "search_suggestion_wait_ms": 350,
  "search_submit_key": "Enter",
  "post_search_wait_ms": 800,
  "add_to_cart_selector": "button.btn-success.icon-left:has-text(\"Vložit do košíku\")",
  "post_modal_open_wait_ms": 280,
  "post_add_wait_ms": 800,
  "hopefix_default_package_type": "box",
  "price_stock_timeout_ms": 8000,
  "navigation_timeout_ms": 20000,
  "navigation_goto_wait_until": "domcontentloaded",
  "headless": false,
  "browser_channel": "chrome"
}
