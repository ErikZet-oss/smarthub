{
  "login_url": "https://www.inoxmare.com/en/customer/account/login/",
  "after_login_url": "https://www.inoxmare.com/en/",
  "login_form_selector": null,
  "username_selector": "#login-form input[name=\"login[username]\"]",
  "password_selector": "#login-form input[name=\"login[password]\"]",
  "login_button_selector": "#login-form button.action.login",
  "login_expect_spring_security_post": false,
  "post_login_wait_ms": 2200,
  "inoxmare_session_cookie_header": "",
  "inoxmare_store_path": "/en",
  "inoxmare_browser_warmup": true,
  "inoxmare_warmup_min_sec": 1.8,
  "inoxmare_warmup_max_sec": 3.6,
  "search_via_url_template": "https://www.inoxmare.com/en/quicksearch/index/resolve/?item={code}&din=&uni=&iso=",
  "post_search_wait_ms": 3500,
  "price_stock_timeout_ms": 20000,
  "navigation_timeout_ms": 60000,
  "navigation_goto_wait_until": "domcontentloaded",
  "headless": false,
  "browser_channel": "chrome",
  "playwright_stealth": true,
  "playwright_human_pause_between_actions": true,
