# Backend API (FastAPI — musí byť táto Smarthub aplikácia z priečinka backend, nie iný projekt na tom istom porte)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Voliteľné: absolútna cesta k Smart_data_Gamechanger.xlsx pre Párovanie / import (lokálne Windows).
# Ak nevyplníš, predvolená je cesta na Renderi (/opt/render/project/src/data/...).
# NEXT_PUBLIC_GAMECHANGER_XLSX_PATH=C:\Users\...\Smart\data\Smart_data_Gamechanger.xlsx

# Tajný kľúč pre JWT (Next cookie + hlavička Authorization na API).
# Musí byť rovnaký na FastAPI (SMARTHUB_AUTH_SECRET v prostredí, kde beží uvicorn).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMARTHUB_AUTH_SECRET=

# Prvý administrátor: pri prvom štarte API sa vytvorí používateľ v SQLite z týchto hodnôt
# (ak tabuľka používateľov ešte neexistuje). Voliteľné po migrácii — potom spravuj účty v Admin.
SMARTHUB_ADMIN_USERNAME=
SMARTHUB_ADMIN_PASSWORD=
