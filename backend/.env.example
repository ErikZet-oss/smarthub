# Skopíruj na .env a doplň rovnaké hodnoty ako vo frontend/.env.local
SMARTHUB_AUTH_SECRET=
SMARTHUB_ADMIN_USERNAME=
SMARTHUB_ADMIN_PASSWORD=
# Produkcia (Neon/Postgres): napr.
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Produkcia (Render persistent disk): napr. /var/data/procurement.db
# Lokálne nechaj prázdne (použije sa backend/procurement.db)
SMARTHUB_DB_PATH=
# Nastav na 1 ak nechceš, aby backend pri štarte automaticky kontroloval/importoval XLSX.
# Import je naďalej dostupný manuálne cez UI (Nastavenia → Import).
SMARTHUB_DISABLE_AUTO_EXCEL_SYNC=
